# 偶艺云承 - Git忽略配置

# 依赖目录
node_modules/

# 构建输出
dist/

# 开发工具
.vscode/
.idea/
*.swp
*.swo
*~

# 环境变量
.env
.env.local
.env.*.local

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.temp
temp/
temp/**/*

# 压缩包
*.zip
*.rar
*.7z

# 锁文件（保持一致性，不锁定依赖版本）
# package-lock.json
